<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.droidx.u00000000"
    android:versionCode="1"
    android:versionName="DROIDX_VERSION___">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/droidx_export_icon"
        android:label="DROIDX_APP______________________________________________________"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.droidx.export.BootstrapActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.droidx.export.SdlExportActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.droidx.export.ConsoleExportActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <service
            android:name="com.droidx.export.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep a user-exported C/C++ program active while backgrounded" />
        </service>

        <service
            android:name="com.droidx.export.ChainScanForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compatibility foreground service for exported ChainScan/C4droid programs" />
        </service>
    </application>
</manifest>
